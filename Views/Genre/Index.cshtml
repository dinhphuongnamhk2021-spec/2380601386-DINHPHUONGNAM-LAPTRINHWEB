@model List<DOANLAPTRINHWWEB.Models.Story>
@{
    ViewData["Title"] = ViewBag.Genre?.Name + " - DocTruyen";
    var genre = ViewBag.Genre as DOANLAPTRINHWWEB.Models.Genre;
    var allGenres = ViewBag.AllGenres as List<DOANLAPTRINHWWEB.Models.Genre>;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

@* ─── CSS riêng cho trang này ───────────────────────────────────────────── *@
<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .genre-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 40px 0;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .genre-header::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 60% 50%, rgba(232,160,69,.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .genre-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .genre-title span {
        color: var(--gold);
    }
    .genre-sub {
        color: rgba(255,255,255,.7);
        font-size: 1rem;
    }

    .genre-nav {
        background: #fff;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 24px;
    }
    .genre-link {
        display: inline-block;
        color: var(--muted);
        text-decoration: none;
        font-size: .9rem;
        padding: 6px 14px;
        border-radius: 20px;
        margin-right: 8px;
        margin-bottom: 8px;
        transition: all .15s;
    }
    .genre-link:hover {
        color: var(--gold);
        background: #fef3c7;
    }
    .genre-link.active {
        background: var(--gold);
        color: #1a1a2e;
        font-weight: 600;
    }

    .story-card {
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        background: var(--card-bg);
        transition: transform .22s ease, box-shadow .22s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .story-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 36px rgba(0,0,0,.12);
    }
    .cover-placeholder {
        aspect-ratio: 3/4;
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        color: rgba(255,255,255,.5);
        font-size: .7rem;
        gap: 8px;
    }
    .cover-placeholder i { font-size: 2.2rem; opacity: .4; }
    .cover-placeholder span {
        font-weight: 600;
        font-size: .65rem;
        text-align: center;
        padding: 0 8px;
        color: rgba(255,255,255,.7);
        line-height: 1.3;
    }
    .story-card-body { padding: 14px 14px 16px; flex: 1; display: flex; flex-direction: column; }
    .story-title {
        font-weight: 700;
        font-size: .9rem;
        color: var(--ink);
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-decoration: none;
        transition: color .15s;
    }
    .story-title:hover { color: var(--gold); }
    .story-author { color: var(--muted); font-size: .75rem; margin-bottom: 8px; }

    .story-meta { margin-top: auto; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .badge-status-done   { background:#d1fae5; color:#065f46; border-radius:20px; font-size:.68rem; padding:2px 10px; font-weight:600; }
    .badge-status-ongoing{ background:#dbeafe; color:#1e40af; border-radius:20px; font-size:.68rem; padding:2px 10px; font-weight:600; }

    .story-stats { display: flex; gap: 10px; font-size: .72rem; color: var(--muted); margin-top: 6px; }
    .story-stats i { font-size: .8rem; }

    .page-link { color: var(--ink); border-radius: 8px !important; margin: 0 2px; border-color: var(--border); }
    .page-item.active .page-link { background: var(--gold); border-color: var(--gold); color: #1a1a2e; font-weight:700; }
    .page-link:hover { background: #fef3c7; color: var(--ink); }

    .empty-state { text-align: center; padding: 60px 20px; color: var(--muted); }
    .empty-state i { font-size: 3.5rem; opacity: .3; display: block; margin-bottom: 16px; }
</style>

@* Google Font Playfair Display *@
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
@* Bootstrap Icons *@
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

@* ─── GENRE HEADER ─────────────────────────────────────────────────────────────── *@
<div class="genre-header">
    <div class="container">
        <h1 class="genre-title">Thể Loại: <span>@genre?.Name</span></h1>
        <p class="genre-sub">@Model.Count truyện trong thể loại này</p>
    </div>
</div>

@* ─── GENRE NAVIGATION ─────────────────────────────────────────────────────────── *@
<div class="genre-nav">
    <div class="container">
        @if (allGenres != null)
        {
            @foreach (var g in allGenres)
            {
                <a asp-controller="Genre" asp-action="Index" asp-route-id="@g.Id" 
                   class="genre-link @(g.Id == genre?.Id ? "active" : "")">
                    @g.Name
                </a>
            }
        }
    </div>
</div>

@* ─── MAIN CONTENT ───────────────────────────────────────────────────────────── *@
<div class="container py-4">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-book"></i>
            <p class="fw-semibold mb-1">Không có truyện nào trong thể loại này</p>
            <a asp-controller="Story" asp-action="Index" class="btn btn-outline-primary mt-2">
                <i class="bi bi-arrow-left me-1"></i>Quay lại trang chủ
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var s in Model)
            {
                <div class="col">
                    <div class="story-card">
                        <div class="cover-placeholder">
                            <i class="bi bi-journal-richtext"></i>
                            <span>@s.Title</span>
                        </div>
                        <div class="story-card-body">
                            <a asp-controller="Story" asp-action="Detail" asp-route-id="@s.Id"
                               class="story-title">@s.Title</a>
                            <div class="story-author">@s.AuthorName</div>
                            <div class="story-meta">
                                @if (s.Status == "Hoàn thành")
                                { <span class="badge-status-done">Full</span> }
                                else
                                { <span class="badge-status-ongoing">Đang ra</span> }
                            </div>
                            <div class="story-stats mt-2">
                                <span><i class="bi bi-book"></i> @s.ChapterCount</span>
                                <span><i class="bi bi-eye"></i> @(s.ViewCount>=1000?(s.ViewCount/1000)+"k":s.ViewCount.ToString())</span>
                                <span><i class="bi bi-star-fill text-warning"></i> @s.Rating</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── PAGINATION ── *@
        @if (totalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Genre" asp-action="Index" 
                               asp-route-id="@genre?.Id" asp-route-page="@(currentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }
                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-controller="Genre" asp-action="Index" 
                               asp-route-id="@genre?.Id" asp-route-page="@p">@p</a>
                        </li>
                    }
                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Genre" asp-action="Index" 
                               asp-route-id="@genre?.Id" asp-route-page="@(currentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
