<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocTruyen Admin</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --ink: #1a1a2e;
            --ink2: #16213e;
            --gold: #e8a045;
            --gold-soft: #f5c878;
            --muted: #6b7280;
            --light-bg: #f3f4f6;
            --card-bg: #ffffff;
            --border: #e5e7eb;
            --sidebar-width: 260px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--light-bg);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            margin: 0;
            overflow-x: hidden;
        }

        /* ── Sidebar Style ── */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: #111122;
            color: rgba(255,255,255,.75);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            box-shadow: 4px 0 20px rgba(0,0,0,.15);
            transition: all .3s ease;
        }
        
        .sidebar-brand {
            padding: 24px;
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            color: var(--gold) !important;
            font-weight: 700;
            text-decoration: none;
            border-bottom: 1px solid rgba(255,255,255,.08);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-menu {
            padding: 20px 14px;
            list-style: none;
            margin: 0;
            flex: 1;
        }

        .sidebar-item {
            margin-bottom: 6px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: rgba(255,255,255,.7);
            text-decoration: none;
            border-radius: 8px;
            font-size: .92rem;
            font-weight: 500;
            transition: all .2s ease;
        }

        .sidebar-link:hover {
            color: #fff;
            background: rgba(255,255,255,.05);
        }

        .sidebar-link.active {
            color: #111122;
            background: var(--gold);
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(232,160,69,.3);
        }

        .sidebar-footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,.08);
            font-size: .85rem;
            color: rgba(255,255,255,.45);
        }

        /* ── Main Panel ── */
        .admin-main {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0; /* Prevents flex items from overflowing */
            min-height: 100vh;
        }

        /* ── Top Header ── */
        .admin-top-bar {
            background: #fff;
            height: 70px;
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }

        .top-bar-title {
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .top-bar-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar-badge {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--ink) 0%, var(--ink2) 100%);
            color: var(--gold);
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(0,0,0,.12);
        }

        /* ── Content Container ── */
        .admin-content {
            padding: 32px;
            flex: 1;
        }

        /* ── Common Card Styles ── */
        .admin-card {
            background: #fff;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 15px rgba(0,0,0,.04);
            border: 1px solid rgba(0,0,0,.02);
            transition: all .25s ease;
        }

        .admin-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid #f3f4f6;
        }

        .admin-card-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Responsive ── */
        @@media (max-width: 992px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            .admin-sidebar.show {
                transform: translateX(0);
            }
            .admin-main {
                margin-left: 0;
            }
            .toggle-sidebar-btn {
                display: block !important;
            }
        }

        .toggle-sidebar-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--ink);
            cursor: pointer;
            padding: 0;
            margin-right: 16px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* ── Sidebar Cột trái ── *@
    <aside class="admin-sidebar" id="adminSidebar">
        <a class="sidebar-brand" href="/Admin">
            📖 DocTruyen Admin
        </a>
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a href="/Admin" class="sidebar-link" id="menu-dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/Admin/Stories" class="sidebar-link" id="menu-stories">
                    <i class="bi bi-book"></i> Quản Lý Truyện
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/Admin/Users" class="sidebar-link" id="menu-users">
                    <i class="bi bi-people"></i> Quản Lý Người Dùng
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/Admin/DepositRequests" class="sidebar-link" id="menu-deposits">
                    <i class="bi bi-cash-coin"></i> Duyệt Nạp Tiền
                </a>
            </li>
            <li class="sidebar-item" style="margin-top: 24px; border-top: 1px solid rgba(255,255,255,.05); padding-top: 16px;">
                <a href="/Story" class="sidebar-link">
                    <i class="bi bi-box-arrow-left"></i> Về Trang Chủ
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            © 2026 Admin Panel
        </div>
    </aside>

    @* ── Main Content Cột phải ── *@
    <div class="admin-main">
        <!-- Top bar -->
        <header class="admin-top-bar">
            <div class="d-flex align-items-center">
                <button class="toggle-sidebar-btn" id="toggleSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <h2 class="top-bar-title">
                    @ViewData["Title"]
                </h2>
            </div>
            <div class="top-bar-user">
                @{
                    var adminUser = Context.Session.GetString("UserName") ?? "Admin";
                    var firstLetter = adminUser[0].ToString().ToUpper();
                }
                <div class="user-avatar-badge">@firstLetter</div>
                <div class="d-none d-md-block text-start">
                    <div class="fw-semibold text-dark" style="font-size: .88rem; line-height: 1.2;">@adminUser</div>
                    <div class="text-muted" style="font-size: .75rem;">Quản trị viên</div>
                </div>
            </div>
        </header>

        <!-- Main content area -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Toggle sidebar on mobile
            $('#toggleSidebar').on('click', function() {
                $('#adminSidebar').toggleClass('show');
            });

            // Close sidebar when clicking outside on mobile
            $(document).on('click', function(e) {
                if ($(window).width() <= 992) {
                    if (!$(e.target).closest('#adminSidebar, #toggleSidebar').length) {
                        $('#adminSidebar').removeClass('show');
                    }
                }
            });

            // Set active class on menu items based on URL path
            var path = window.location.pathname.toLowerCase();
            if (path === '/admin' || path === '/admin/') {
                $('#menu-dashboard').addClass('active');
            } else if (path.indexOf('/admin/stories') === 0 || path.indexOf('/admin/createstory') === 0 || path.indexOf('/admin/editstory') === 0) {
                $('#menu-stories').addClass('active');
            } else if (path.indexOf('/admin/users') === 0) {
                $('#menu-users').addClass('active');
            } else if (path.indexOf('/admin/depositrequests') === 0) {
                $('#menu-deposits').addClass('active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
