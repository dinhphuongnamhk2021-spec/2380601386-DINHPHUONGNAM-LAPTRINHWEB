@model List<DOANLAPTRINHWWEB.Models.Story>
@{
    ViewData["Title"] = "Quản Lý Truyện";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Modern Table Styles ── */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }

        .admin-table th {
            font-weight: 600;
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--muted);
            padding: 14px 16px;
            background: #f9fafb;
            border-bottom: 1px solid var(--border);
        }

        .admin-table td {
            padding: 14px 16px;
            font-size: .9rem;
            color: #374151;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .admin-table tbody tr {
            transition: all .2s ease;
        }

        .admin-table tbody tr:hover td {
            background-color: #f9fafb;
        }

        /* Action buttons */
        .btn-action-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all .15s ease;
            border: none;
            margin-right: 4px;
        }
        
        .btn-action-view {
            background: #e0f2fe;
            color: #0369a1;
        }
        .btn-action-view:hover {
            background: #bae6fd;
            color: #0284c7;
        }

        .btn-action-edit {
            background: #fef3c7;
            color: #b45309;
        }
        .btn-action-edit:hover {
            background: #fde68a;
            color: #92400e;
        }

        .btn-action-delete {
            background: #fee2e2;
            color: #b91c1c;
        }
        .btn-action-delete:hover {
            background: #fecaca;
            color: #991b1b;
        }

        /* Filter Row */
        .filter-container {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .search-wrapper {
            flex: 1;
            min-width: 280px;
            position: relative;
        }

        .search-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .search-input {
            padding-left: 40px !important;
        }
    </style>
}

<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-list-ul text-primary"></i> Danh Sách Truyện
        </h3>
        <a asp-action="CreateStory" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2" style="background: var(--gold); border-color: var(--gold); color: #111122; font-weight: 600; font-size: .88rem; border-radius: 8px;">
            <i class="bi bi-plus-circle"></i> Thêm Truyện Mới
        </a>
    </div>

    <!-- Filters -->
    <div class="filter-container">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" id="storySearchInput" class="form-control search-input" placeholder="Tìm kiếm theo tên truyện, tác giả, thể loại..." />
        </div>
        <div style="width: 200px;">
            <select id="storyStatusFilter" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="Full">Hoàn thành (Full)</option>
                <option value="Đang ra">Đang ra</option>
            </select>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="admin-table" id="storiesTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tiêu đề</th>
                        <th>Tác giả</th>
                        <th>Thể loại</th>
                        <th>Trạng thái</th>
                        <th style="width: 90px; text-align: center;">Chương</th>
                        <th style="width: 110px;">Lượt xem</th>
                        <th style="width: 140px; text-align: center;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var story in Model)
                    {
                        var genreText = story.StoryGenres.Any() 
                            ? string.Join(", ", story.StoryGenres.Select(sg => sg.Genre.Name)) 
                            : "";
                        <tr class="story-row" data-title="@story.Title.ToLower()" data-author="@story.AuthorName.ToLower()" data-genres="@genreText.ToLower()" data-status="@(story.Status == "Hoàn thành" ? "full" : "đang ra")">
                            <td class="text-muted fw-bold">@story.Id</td>
                            <td>
                                <a asp-controller="Story" asp-action="Detail" asp-route-id="@story.Id" 
                                   class="text-decoration-none fw-bold text-dark">@story.Title</a>
                            </td>
                            <td>@story.AuthorName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(genreText))
                                {
                                    <span class="text-muted" style="font-size: .85rem;">@genreText</span>
                                }
                                else
                                {
                                    <span class="text-muted-light" style="font-size: .85rem; font-style: italic; opacity: 0.6;">Chưa có</span>
                                }
                            </td>
                            <td>
                                @if (story.Status == "Hoàn thành")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Full</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Đang ra</span>
                                }
                            </td>
                            <td style="text-align: center;" class="fw-semibold">@story.ChapterCount</td>
                            <td class="text-muted">@story.ViewCount.ToString("N0")</td>
                            <td>
                                <div class="d-flex justify-content-center">
                                    <a asp-controller="Story" asp-action="Detail" asp-route-id="@story.Id" 
                                       class="btn-action-icon btn-action-view" title="Xem truyện">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="EditStory" asp-route-id="@story.Id" 
                                       class="btn-action-icon btn-action-edit" title="Sửa truyện">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="DeleteStory" asp-route-id="@story.Id" 
                                       class="btn-action-icon btn-action-delete" title="Xóa truyện"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa truyện này?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-book fs-1 d-block mb-3" style="opacity: 0.3;"></i>
            <p>Chưa có truyện nào trong hệ thống.</p>
            <a asp-action="CreateStory" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Thêm Truyện Đầu Tiên
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Lọc dữ liệu qua Javascript
            function filterStories() {
                var searchVal = $('#storySearchInput').val().toLowerCase().trim();
                var statusVal = $('#storyStatusFilter').val().toLowerCase();

                $('.story-row').each(function() {
                    var $row = $(this);
                    
                    var title = $row.data('title');
                    var author = $row.data('author');
                    var genres = $row.data('genres');
                    var status = $row.data('status');

                    // Check search text
                    var matchesSearch = !searchVal || 
                                        title.indexOf(searchVal) > -1 || 
                                        author.indexOf(searchVal) > -1 || 
                                        genres.indexOf(searchVal) > -1;
                    
                    // Check status dropdown
                    var matchesStatus = !statusVal || status === statusVal;

                    if (matchesSearch && matchesStatus) {
                        $row.show();
                    } else {
                        $row.hide();
                    }
                });
            }

            // Gắn sự kiện change/input
            $('#storySearchInput').on('input', filterStories);
            $('#storyStatusFilter').on('change', filterStories);
        });
    </script>
}
