@model List<DOANLAPTRINHWWEB.Models.Story>
@{
    ViewData["Title"] = "Quản Lý Truyện - Admin";
}

@* ─── CSS riêng cho trang này ───────────────────────────────────────────── *@
<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .admin-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 30px 0;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .admin-header::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 60% 50%, rgba(232,160,69,.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .admin-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .admin-title span {
        color: var(--gold);
    }

    .content-section {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--gold);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .table {
        margin-bottom: 0;
    }
    .table thead th {
        background: #f9fafb;
        font-weight: 600;
        color: var(--ink);
        border-bottom: 2px solid var(--gold);
    }
    .table tbody tr {
        transition: background .15s;
    }
    .table tbody tr:hover {
        background: #f9fafb;
    }

    .badge-status-done {
        background: #d1fae5;
        color: #065f46;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 600;
    }
    .badge-status-ongoing {
        background: #dbeafe;
        color: #1e40af;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 600;
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: .85rem;
        text-decoration: none;
        transition: all .15s;
        margin-right: 4px;
    }
    .btn-view {
        background: #dbeafe;
        color: #1e40af;
    }
    .btn-view:hover {
        background: #bfdbfe;
    }
    .btn-edit {
        background: #fef3c7;
        color: #92400e;
    }
    .btn-edit:hover {
        background: #fde68a;
    }
    .btn-delete {
        background: #fee2e2;
        color: #991b1b;
    }
    .btn-delete:hover {
        background: #fecaca;
    }
</style>

@* Google Font Playfair Display *@
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
@* Bootstrap Icons *@
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

@* ─── ADMIN HEADER ─────────────────────────────────────────────────────────────── *@
<div class="admin-header">
    <div class="container">
        <h1 class="admin-title">Quản Lý <span>Truyện</span></h1>
    </div>
</div>

@* ─── MAIN CONTENT ───────────────────────────────────────────────────────────── *@
<div class="container py-4">
    <div class="content-section">
        <div class="section-title">
            <span><i class="bi bi-book me-2"></i>Danh Sách Truyện</span>
            <a asp-action="CreateStory" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Thêm Truyện Mới
            </a>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tiêu đề</th>
                            <th>Tác giả</th>
                            <th>Thể loại</th>
                            <th>Trạng thái</th>
                            <th>Chương</th>
                            <th>Lượt xem</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var story in Model)
                        {
                            <tr>
                                <td>@story.Id</td>
                                <td>
                                    <a asp-controller="Story" asp-action="Detail" asp-route-id="@story.Id" 
                                       class="text-decoration-none fw-bold">@story.Title</a>
                                </td>
                                <td>@story.AuthorName</td>
                                <td>
                                    @if (story.StoryGenres.Any())
                                    {
                                        @string.Join(", ", story.StoryGenres.Select(sg => sg.Genre.Name))
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có</span>
                                    }
                                </td>
                                <td>
                                    @if (story.Status == "Hoàn thành")
                                    {
                                        <span class="badge-status-done">Full</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-ongoing">Đang ra</span>
                                    }
                                </td>
                                <td>@story.ChapterCount</td>
                                <td>@story.ViewCount.ToString("N0")</td>
                                <td>
                                    <a asp-controller="Story" asp-action="Detail" asp-route-id="@story.Id" 
                                       class="btn-action btn-view" title="Xem">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="EditStory" asp-route-id="@story.Id" 
                                       class="btn-action btn-edit" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="DeleteStory" asp-route-id="@story.Id" 
                                       class="btn-action btn-delete" title="Xóa"
                                       onclick="return confirm('Bạn có chắc muốn xóa truyện này?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-book" style="font-size: 3rem; color: var(--muted); opacity: .3;"></i>
                <p class="text-muted mt-3">Chưa có truyện nào</p>
                <a asp-action="CreateStory" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle me-2"></i>Thêm Truyện Đầu Tiên
                </a>
            </div>
        }
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Quay lại Dashboard
        </a>
    </div>
</div>
