@model DOANLAPTRINHWWEB.Controllers.AdminViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Widget Custom Cards ── */
        .widget-card {
            border-radius: 16px;
            padding: 24px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,.08);
            transition: all .3s ease;
        }

        .widget-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,.15);
        }

        .widget-card::before {
            content: '';
            position: absolute;
            width: 130px;
            height: 130px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 50%;
            top: -20px;
            right: -20px;
        }

        .widget-1 { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); }
        .widget-2 { background: linear-gradient(135deg, #e8a045 0%, #b45309 100%); }
        .widget-3 { background: linear-gradient(135deg, #10b981 0%, #047857 100%); }
        .widget-4 { background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); }

        .widget-info h3 {
            font-size: 2.1rem;
            font-weight: 800;
            margin: 0 0 4px 0;
            letter-spacing: -0.5px;
        }
        
        .widget-info p {
            font-size: .88rem;
            margin: 0;
            opacity: 0.85;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .widget-icon-box {
            width: 54px;
            height: 54px;
            background: rgba(255, 255, 255, 0.18);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        /* ── Modern Table Styles ── */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }

        .admin-table th {
            font-weight: 600;
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--muted);
            padding: 14px 16px;
            background: #f9fafb;
            border-bottom: 1px solid var(--border);
        }

        .admin-table td {
            padding: 16px;
            font-size: .9rem;
            color: #374151;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .admin-table tbody tr:hover td {
            background-color: #f9fafb;
        }

        /* ── Action buttons inside layout cards ── */
        .action-link {
            font-size: .85rem;
            font-weight: 600;
            color: var(--gold);
            text-decoration: none;
            transition: all .2s;
        }
        .action-link:hover {
            color: var(--gold-soft);
        }
    </style>
}

<!-- Top Widgets Row -->
<div class="row g-4 mb-4">
    <!-- Users widget -->
    <div class="col-sm-6 col-xl-3">
        <div class="widget-card widget-1">
            <div class="widget-info">
                <h3>@Model.TotalUsers.ToString("N0")</h3>
                <p>Người dùng</p>
            </div>
            <div class="widget-icon-box">
                <i class="bi bi-people"></i>
            </div>
        </div>
    </div>
    <!-- Stories widget -->
    <div class="col-sm-6 col-xl-3">
        <div class="widget-card widget-2">
            <div class="widget-info">
                <h3>@Model.TotalStories.ToString("N0")</h3>
                <p>Truyện</p>
            </div>
            <div class="widget-icon-box">
                <i class="bi bi-book"></i>
            </div>
        </div>
    </div>
    <!-- Chapters widget -->
    <div class="col-sm-6 col-xl-3">
        <div class="widget-card widget-3">
            <div class="widget-info">
                <h3>@Model.TotalChapters.ToString("N0")</h3>
                <p>Chương</p>
            </div>
            <div class="widget-icon-box">
                <i class="bi bi-file-text"></i>
            </div>
        </div>
    </div>
    <!-- Views widget -->
    <div class="col-sm-6 col-xl-3">
        <div class="widget-card widget-4">
            <div class="widget-info">
                <h3>@Model.TotalViews.ToString("N0")</h3>
                <p>Lượt xem</p>
            </div>
            <div class="widget-icon-box">
                <i class="bi bi-eye"></i>
            </div>
        </div>
    </div>
</div>

<!-- Chart Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="bi bi-bar-chart-line text-warning"></i> Thống kê Lượt xem Truyện Mới
                </h3>
            </div>
            <div style="position: relative; height: 320px; width: 100%;">
                <canvas id="viewsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Recent Stories -->
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="bi bi-clock-history text-primary"></i> Truyện Mới Đăng
                </h3>
                <a asp-action="Stories" class="action-link">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            
            @if (Model.RecentStories.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Tiêu đề</th>
                                <th>Tác giả</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var story in Model.RecentStories)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Story" asp-action="Detail" asp-route-id="@story.Id" 
                                           class="text-decoration-none fw-bold text-dark">@story.Title</a>
                                    </td>
                                    <td>@story.AuthorName</td>
                                    <td>
                                        @if (story.Status == "Hoàn thành")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Full</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Đang ra</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i> Chưa có truyện nào
                </div>
            }
        </div>
    </div>

    <!-- Recent Users -->
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="bi bi-person-plus text-success"></i> Thành Viên Mới
                </h3>
                <a asp-action="Users" class="action-link">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            
            @if (Model.RecentUsers.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Tên đăng nhập</th>
                                <th>Email</th>
                                <th>Vai trò</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td class="fw-semibold">@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">User</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i> Chưa có người dùng nào
                </div>
            }
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="bi bi-lightning-charge-fill text-warning"></i> Thao Tác Nhanh
        </h3>
    </div>
    <div class="d-flex gap-3 flex-wrap">
        <a asp-action="CreateStory" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2" style="background: var(--gold); border-color: var(--gold); color: #111122; font-weight: 600;">
            <i class="bi bi-plus-circle"></i> Thêm Truyện Mới
        </a>
        <a asp-action="Stories" class="btn btn-outline-dark d-inline-flex align-items-center gap-2 px-4 py-2" style="font-weight: 500;">
            <i class="bi bi-book"></i> Quản Lý Truyện
        </a>
        <a asp-action="Users" class="btn btn-outline-dark d-inline-flex align-items-center gap-2 px-4 py-2" style="font-weight: 500;">
            <i class="bi bi-people"></i> Quản Lý Người Dùng
        </a>
        <a href="/" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-4 py-2" style="font-weight: 500;">
            <i class="bi bi-house"></i> Về Trang Đọc Truyện
        </a>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Chart.js qua CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Chuẩn bị dữ liệu từ Model
            var labels = [@Html.Raw(string.Join(",", Model.RecentStories.Select(s => $"\"{s.Title}\"")))];
            var dataViews = [@string.Join(",", Model.RecentStories.Select(s => s.ViewCount))];

            var ctx = document.getElementById('viewsChart').getContext('2d');
            var viewsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Lượt xem',
                        data: dataViews,
                        backgroundColor: 'rgba(232, 160, 69, 0.75)',
                        borderColor: 'rgba(232, 160, 69, 1)',
                        borderWidth: 2,
                        borderRadius: 8,
                        hoverBackgroundColor: 'rgba(232, 160, 69, 0.95)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                font: {
                                    family: "'Plus Jakarta Sans', sans-serif"
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    family: "'Plus Jakarta Sans', sans-serif"
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
