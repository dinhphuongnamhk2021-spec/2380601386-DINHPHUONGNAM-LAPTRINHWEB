@model List<DOANLAPTRINHWWEB.Models.User>
@{
    ViewData["Title"] = "Quản Lý Người Dùng - Admin";
}

@* ─── CSS riêng cho trang này ───────────────────────────────────────────── *@
<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .admin-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 30px 0;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .admin-header::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 60% 50%, rgba(232,160,69,.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .admin-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .admin-title span {
        color: var(--gold);
    }

    .content-section {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--gold);
    }

    .table {
        margin-bottom: 0;
    }
    .table thead th {
        background: #f9fafb;
        font-weight: 600;
        color: var(--ink);
        border-bottom: 2px solid var(--gold);
    }
    .table tbody tr {
        transition: background .15s;
    }
    .table tbody tr:hover {
        background: #f9fafb;
    }

    .badge-role-admin {
        background: rgba(239, 68, 68, .1);
        color: #ef4444;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 600;
    }
    .badge-role-user {
        background: rgba(59, 130, 246, .1);
        color: #3b82f6;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 600;
    }
</style>

@* Google Font Playfair Display *@
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
@* Bootstrap Icons *@
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

@* ─── ADMIN HEADER ─────────────────────────────────────────────────────────────── *@
<div class="admin-header">
    <div class="container">
        <h1 class="admin-title">Quản Lý <span>Người Dùng</span></h1>
    </div>
</div>

@* ─── MAIN CONTENT ───────────────────────────────────────────────────────────── *@
<div class="container py-4">
    <div class="content-section">
        <div class="section-title">
            <span><i class="bi bi-people me-2"></i>Danh Sách Người Dùng</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tên đăng nhập</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tham gia</th>
                            <th>Số truyện</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge-role-admin">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge-role-user">User</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>@user.Stories.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people" style="font-size: 3rem; color: var(--muted); opacity: .3;"></i>
                <p class="text-muted mt-3">Chưa có người dùng nào</p>
            </div>
        }
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Quay lại Dashboard
        </a>
    </div>
</div>
