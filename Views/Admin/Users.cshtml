@model List<DOANLAPTRINHWWEB.Models.User>
@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentUserId = Context.Session.GetInt32("UserId");
}

@section Styles {
    <style>
        /* ── Modern Table Styles ── */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }

        .admin-table th {
            font-weight: 600;
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--muted);
            padding: 14px 16px;
            background: #f9fafb;
            border-bottom: 1px solid var(--border);
        }

        .admin-table td {
            padding: 14px 16px;
            font-size: .9rem;
            color: #374151;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .admin-table tbody tr {
            transition: all .2s ease;
        }

        .admin-table tbody tr:hover td {
            background-color: #f9fafb;
        }

        /* Filter Row */
        .filter-container {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .search-wrapper {
            flex: 1;
            min-width: 280px;
            position: relative;
        }

        .search-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .search-input {
            padding-left: 40px !important;
        }
    </style>
}

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #d1e7dd; color: #0f5132;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #f8d7da; color: #842029;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <div class="admin-card">
        <div class="admin-card-header">
            <h3 class="admin-card-title">
                <i class="bi bi-people-fill text-primary"></i> Danh Sách Người Dùng
            </h3>
        </div>

        <!-- Filters -->
        <div class="filter-container">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="userSearchInput" class="form-control search-input" placeholder="Tìm kiếm theo tên đăng nhập hoặc email..." />
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="admin-table" id="usersTable">
                    <thead>
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Tên đăng nhập</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tham gia</th>
                            <th style="width: 150px; text-align: center;">Số truyện đã đăng</th>
                            <th style="width: 130px; text-align: center;">Số dư (Xu)</th>
                            <th style="width: 320px; text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr class="user-row" data-username="@user.UserName.ToLower()" data-email="@user.Email.ToLower()">
                                <td class="text-muted fw-bold">@user.Id</td>
                                <td class="fw-semibold text-dark">@user.UserName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">User</span>
                                    }
                                </td>
                                <td class="text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td style="text-align: center;" class="fw-semibold">@user.Stories.Count</td>
                                <td style="text-align: center;" class="fw-bold text-warning">@user.Balance Xu</td>
                                <td style="text-align: center;">
                                    @if (user.Id == currentUserId)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 me-1">Đang đăng nhập</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 me-1" onclick="openBalanceModal(@user.Id, '@user.UserName', @user.Balance)">
                                        <i class="bi bi-coin"></i> Số dư
                                    </button>
                                    @if (user.Id != currentUserId)
                                    {
                                        @if (user.Role != "Admin")
                                        {
                                            <form asp-action="ChangeRole" method="post" style="display:inline;">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="role" value="Admin" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1" onclick="return confirm('Bạn có chắc chắn muốn thăng cấp người dùng này lên Admin?')">
                                                    <i class="bi bi-arrow-up-circle-fill"></i> Thăng cấp
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="DeleteUser" method="post" style="display:inline; margin-left: 5px;">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" onclick="return confirm('Bạn có chắc chắn muốn xóa người dùng này? Tất cả các truyện thuộc về người dùng này sẽ không còn tác giả liên kết.')">
                                                <i class="bi bi-trash-fill"></i> Xóa
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Modal cập nhật số dư -->
            <div class="modal fade" id="balanceModal" tabindex="-1" aria-labelledby="balanceModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                        <div class="modal-header bg-warning text-dark" style="border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom: none;">
                            <h5 class="modal-title fw-bold" id="balanceModalLabel"><i class="bi bi-coin me-1"></i> Điều Chỉnh Số Dư Xu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-action="UpdateUserBalance" method="post">
                            <div class="modal-body p-4">
                                <input type="hidden" name="userId" id="modalUserId" />
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark">Người dùng:</label>
                                    <input type="text" id="modalUserName" class="form-control bg-light" readonly />
                                </div>
                                <div class="mb-3">
                                    <label for="modalBalanceInput" class="form-label fw-bold text-dark">Số dư Xu mới *</label>
                                    <input type="number" name="balance" id="modalBalanceInput" class="form-control" min="0" required />
                                    <span class="text-muted small d-block mt-1">Nhập số xu lớn hơn hoặc bằng 0.</span>
                                </div>
                            </div>
                            <div class="modal-footer border-0 p-3 bg-light" style="border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;">
                                <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-warning px-4 rounded-pill text-dark fw-bold">Cập Nhật</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people fs-1 d-block mb-3" style="opacity: 0.3;"></i>
            <p>Chưa có người dùng nào trong hệ thống.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Lọc dữ liệu qua Javascript
            $('#userSearchInput').on('input', function() {
                var searchVal = $(this).val().toLowerCase().trim();

                $('.user-row').each(function() {
                    var $row = $(this);
                    var username = $row.data('username');
                    var email = $row.data('email');

                    var matches = !searchVal || 
                                  username.indexOf(searchVal) > -1 || 
                                  email.indexOf(searchVal) > -1;

                    if (matches) {
                        $row.show();
                    } else {
                        $row.hide();
                    }
                });
            });
        });

        function openBalanceModal(userId, userName, currentBalance) {
            $('#modalUserId').val(userId);
            $('#modalUserName').val(userName);
            $('#modalBalanceInput').val(currentBalance);
            
            var modal = new bootstrap.Modal(document.getElementById('balanceModal'));
            modal.show();
        }
    </script>
}
