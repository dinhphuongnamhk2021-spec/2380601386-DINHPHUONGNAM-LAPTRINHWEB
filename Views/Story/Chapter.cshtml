@model DOANLAPTRINHWWEB.Models.Chapter
@{
    ViewData["Title"] = Model.Title + " - " + Model.Story.Title;
    var prevChapter = ViewBag.PrevChapter as DOANLAPTRINHWWEB.Models.Chapter;
    var nextChapter = ViewBag.NextChapter as DOANLAPTRINHWWEB.Models.Chapter;
    var allChapters = ViewBag.AllChapters as System.Collections.Generic.List<DOANLAPTRINHWWEB.Models.Chapter>;
}

@* ─── CSS riêng cho trang này ───────────────────────────────────────────── *@
<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --bg-light: #f8f9fa;
    }

    .chapter-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 32px 0;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .chapter-header::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 60% 50%, rgba(232,160,69,.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .breadcrumb-nav {
        background: #fff;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 24px;
    }
    .breadcrumb-nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: .9rem;
    }
    .breadcrumb-nav a:hover {
        color: var(--gold);
    }
    .breadcrumb-nav .separator {
        color: #d1d5db;
        margin: 0 8px;
    }
    .breadcrumb-nav .current {
        color: var(--ink);
        font-weight: 600;
    }

    .chapter-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
    }
    .chapter-story {
        color: rgba(255,255,255,.7);
        font-size: 1rem;
    }
    .chapter-story a {
        color: var(--gold);
        text-decoration: none;
    }

    .chapter-content {
        background: #fff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        line-height: 2;
        font-size: 1.1rem;
        color: #374151;
        min-height: 400px;
    }
    .chapter-content p {
        margin-bottom: 20px;
        text-align: justify;
    }

    .chapter-nav {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 24px;
    }
    .chapter-nav-btn {
        flex: 1;
        padding: 14px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        text-align: center;
        transition: all .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .chapter-nav-btn.primary {
        background: var(--gold);
        color: #1a1a2e;
    }
    .chapter-nav-btn.primary:hover {
        background: var(--gold-soft);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(232,160,69,.4);
    }
    .chapter-nav-btn.secondary {
        background: #f3f4f6;
        color: #374151;
    }
    .chapter-nav-btn.secondary:hover {
        background: #e5e7eb;
    }
    .chapter-nav-btn:disabled {
        opacity: .5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .chapter-list-sidebar {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        max-height: 600px;
        overflow-y: auto;
    }
    .chapter-list-sidebar h4 {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--gold);
    }
    .sidebar-chapter-item {
        display: block;
        padding: 10px 14px;
        border-radius: 8px;
        text-decoration: none;
        color: #374151;
        font-size: .9rem;
        margin-bottom: 4px;
        transition: all .15s;
    }
    .sidebar-chapter-item:hover {
        background: #f9fafb;
        color: var(--gold);
    }
    .sidebar-chapter-item.active {
        background: var(--gold);
        color: #1a1a2e;
        font-weight: 600;
    }
    .sidebar-chapter-number {
        display: inline-block;
        width: 24px;
        height: 24px;
        background: var(--ink);
        color: #fff;
        border-radius: 6px;
        text-align: center;
        line-height: 24px;
        font-size: .75rem;
        margin-right: 8px;
    }
    .sidebar-chapter-item.active .sidebar-chapter-number {
        background: #fff;
        color: var(--gold);
    }

    .reading-settings {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        margin-top: 24px;
    }
    .reading-settings h4 {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 12px;
    }
    .setting-btn {
        padding: 8px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: .9rem;
        cursor: pointer;
        transition: all .15s;
        margin-right: 8px;
        margin-bottom: 8px;
    }
    .setting-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
    }
    .setting-btn.active {
        background: var(--gold);
        border-color: var(--gold);
        color: #1a1a2e;
    }

    @@media (max-width: 768px) {
        .chapter-content { padding: 24px; font-size: 1rem; }
        .chapter-title { font-size: 1.4rem; }
        .chapter-nav { flex-direction: column; }
        .chapter-nav-btn { width: 100%; }
    }
</style>

@* ─── BREADCRUMB ─────────────────────────────────────────────────────────────── *@
<div class="breadcrumb-nav">
    <div class="container">
        <a href="/Story">Trang chủ</a>
        <span class="separator">/</span>
        <a href="/Story/Detail/@Model.Story.Id">@Model.Story.Title</a>
        <span class="separator">/</span>
        <span class="current">Chương @Model.ChapterNumber</span>
    </div>
</div>

@* ─── CHAPTER HEADER ─────────────────────────────────────────────────────────── *@
<div class="chapter-header">
    <div class="container">
        <h1 class="chapter-title">Chương @Model.ChapterNumber: @Model.Title</h1>
        <div class="chapter-story">
            Truyện: <a href="/Story/Detail/@Model.Story.Id">@Model.Story.Title</a>
            @if (Model.Price > 0)
            {
                <span class="ms-3 badge bg-warning text-dark">Đã mở khóa: @Model.Price.ToString("N0") đ</span>
            }
        </div>
    </div>
</div>

@* ─── MAIN CONTENT ───────────────────────────────────────────────────────────── *@
<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    <div class="row">
        <div class="col-lg-8">
            @* Chapter Content *@
            <div class="chapter-content" id="chapterContent">
                @if (!string.IsNullOrEmpty(Model.Content))
                {
                    @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                }
                else
                {
                    <p class="text-center text-muted">Nội dung đang được cập nhật...</p>
                }
            </div>

            @* Navigation Buttons *@
            <div class="chapter-nav">
                @if (prevChapter != null)
                {
                    <a href="/Story/Chapter/@prevChapter.Id" class="chapter-nav-btn secondary">
                        <i class="bi bi-chevron-left"></i>
                        Chương trước
                    </a>
                }
                else
                {
                    <button class="chapter-nav-btn secondary" disabled>
                        <i class="bi bi-chevron-left"></i>
                        Chương trước
                    </button>
                }

                <a href="/Story/Detail/@Model.Story.Id" class="chapter-nav-btn primary">
                    <i class="bi bi-list"></i>
                    Mục lục
                </a>

                @if (nextChapter != null)
                {
                    <a href="/Story/Chapter/@nextChapter.Id" class="chapter-nav-btn secondary">
                        Chương sau
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <button class="chapter-nav-btn secondary" disabled>
                        Chương sau
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>

            @* Reading Settings *@
            <div class="reading-settings">
                <h4><i class="bi bi-gear me-2"></i>Cài đặt đọc</h4>
                <button class="setting-btn" onclick="changeFontSize('small')">Nhỏ</button>
                <button class="setting-btn active" onclick="changeFontSize('medium')">Vừa</button>
                <button class="setting-btn" onclick="changeFontSize('large')">Lớn</button>
                <button class="setting-btn" onclick="toggleTheme()">Đổi giao diện</button>
            </div>
        </div>

        <div class="col-lg-4">
            @* Chapter List Sidebar *@
            <div class="chapter-list-sidebar">
                <h4><i class="bi bi-list-ul me-2"></i>Danh sách chương</h4>
                @if (allChapters != null && allChapters.Any())
                {
                    @foreach (var ch in allChapters)
                    {
                        <a href="/Story/Chapter/@ch.Id" 
                           class="sidebar-chapter-item @(ch.Id == Model.Id ? "active" : "")">
                            <span class="sidebar-chapter-number">@ch.ChapterNumber</span>
                            @ch.Title
                        </a>
                    }
                }
            </div>

            @* Story Info *@
            <div class="content-section mt-4" style="background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,.06);">
                <h4 style="font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--ink); margin-bottom: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--gold);">
                    <i class="bi bi-info-circle me-2"></i>Thông tin truyện
                </h4>
                <p style="margin-bottom: 8px;"><strong>Tác giả:</strong> @Model.Story.Author</p>
                <p style="margin-bottom: 8px;"><strong>Thể loại:</strong> @Model.Story.Genre</p>
                <p style="margin-bottom: 8px;"><strong>Trạng thái:</strong> @Model.Story.Status</p>
                <p style="margin-bottom: 0;"><strong>Số chương:</strong> @Model.Story.ChapterCount</p>
            </div>
        </div>
    </div>
</div>

@* ─── JAVASCRIPT ─────────────────────────────────────────────────────────────── *@
<script>
    let currentFontSize = 'medium';
    let isDarkTheme = false;

    function changeFontSize(size) {
        const content = document.getElementById('chapterContent');
        const buttons = document.querySelectorAll('.setting-btn');
        
        // Remove active class from all size buttons
        buttons.forEach(btn => {
            if (btn.textContent.includes('Nhỏ') || btn.textContent.includes('Vừa') || btn.textContent.includes('Lớn')) {
                btn.classList.remove('active');
            }
        });

        // Add active class to clicked button
        event.target.classList.add('active');

        switch(size) {
            case 'small':
                content.style.fontSize = '0.95rem';
                break;
            case 'medium':
                content.style.fontSize = '1.1rem';
                break;
            case 'large':
                content.style.fontSize = '1.3rem';
                break;
        }
        currentFontSize = size;
    }

    function toggleTheme() {
        isDarkTheme = !isDarkTheme;
        const content = document.getElementById('chapterContent');
        const sidebar = document.querySelector('.chapter-list-sidebar');
        const sections = document.querySelectorAll('.content-section');
        
        if (isDarkTheme) {
            content.style.background = '#1a1a2e';
            content.style.color = '#e5e7eb';
            sidebar.style.background = '#1a1a2e';
            sidebar.style.color = '#e5e7eb';
            sections.forEach(s => {
                s.style.background = '#1a1a2e';
                s.style.color = '#e5e7eb';
            });
            event.target.classList.add('active');
        } else {
            content.style.background = '#fff';
            content.style.color = '#374151';
            sidebar.style.background = '#fff';
            sidebar.style.color = '#374151';
            sections.forEach(s => {
                s.style.background = '#fff';
                s.style.color = '#374151';
            });
            event.target.classList.remove('active');
        }
    }

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
        @if (prevChapter != null)
        {
            <text>if (e.key === 'ArrowLeft') {
                window.location.href = '/Story/Chapter/@prevChapter.Id';
            } else </text>
        }
        @if (nextChapter != null)
        {
            <text>if (e.key === 'ArrowRight') {
                window.location.href = '/Story/Chapter/@nextChapter.Id';
            }</text>
        }
    });
</script>
