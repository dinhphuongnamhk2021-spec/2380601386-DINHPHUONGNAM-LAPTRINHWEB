@model IEnumerable<DOANLAPTRINHWWEB.Models.Story>
@{
    ViewData["Title"] = "Truyện Yêu Thích - DocTruyen";
}

<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .favorites-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 40px 0;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 40px;
    }
    .favorites-header::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 60% 50%, rgba(232,160,69,.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .favorites-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 8px;
        position: relative;
        z-index: 1;
    }

    .favorites-header p {
        color: rgba(255,255,255,.8);
        font-size: 1.05rem;
        position: relative;
        z-index: 1;
    }

    .stories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .story-card {
        background: var(--card-bg);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        transition: all .3s ease;
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .story-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0,0,0,.15);
    }

    .story-cover {
        aspect-ratio: 3/4;
        overflow: hidden;
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .story-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .3s ease;
    }

    .story-card:hover .story-cover img {
        transform: scale(1.05);
    }

    .story-cover i {
        font-size: 3rem;
        color: rgba(255,255,255,.3);
    }

    .story-info {
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .story-title {
        font-weight: 700;
        font-size: 1rem;
        color: var(--ink);
        margin-bottom: 6px;
        line-height: 1.3;
        max-height: 2.6em;
        overflow: hidden;
    }

    .story-author {
        font-size: 0.85rem;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .story-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .story-rating {
        color: var(--gold);
        font-weight: 600;
    }

    .story-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 12px;
        flex: 1;
        align-content: flex-start;
    }

    .genre-badge {
        background: rgba(232,160,69,.15);
        color: var(--gold);
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 500;
    }

    .story-actions {
        display: flex;
        gap: 8px;
    }

    .btn-small {
        flex: 1;
        padding: 8px;
        border: none;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        text-align: center;
        display: inline-block;
    }

    .btn-read {
        background: var(--gold);
        color: var(--ink);
    }

    .btn-read:hover {
        background: var(--gold-soft);
    }

    .btn-remove {
        background: #f3f4f6;
        color: #ef4444;
    }

    .btn-remove:hover {
        background: #fee2e2;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--muted);
    }

    .empty-state i {
        font-size: 4rem;
        color: #e5e7eb;
        display: block;
        margin-bottom: 16px;
    }

    .empty-state h2 {
        font-size: 1.5rem;
        color: var(--ink);
        margin-bottom: 12px;
    }

    .empty-state p {
        margin-bottom: 24px;
    }

    .btn-back {
        display: inline-block;
        padding: 12px 24px;
        background: var(--gold);
        color: var(--ink);
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all .2s;
    }

    .btn-back:hover {
        background: var(--gold-soft);
        transform: translateY(-2px);
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 40px;
        margin-bottom: 40px;
    }

    .pagination a,
    .pagination span {
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid var(--border);
        text-decoration: none;
        color: var(--ink);
        transition: all .2s;
    }

    .pagination a:hover {
        background: var(--gold);
        border-color: var(--gold);
        color: var(--ink);
    }

    .pagination .active {
        background: var(--gold);
        border-color: var(--gold);
        font-weight: 600;
    }
</style>

<div class="favorites-header">
    <div class="container">
        <h1>
            <i class="bi bi-heart-fill" style="color: #e74c3c; margin-right: 12px;"></i>
            Truyện Yêu Thích
        </h1>
        <p>
            Danh sách <strong>@ViewBag.Total truyện</strong> được bạn lưu để đọc lại sau
        </p>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-heart"></i>
            <h2>Chưa có truyện yêu thích</h2>
            <p>Hãy khám phá những truyện hay và lưu chúng vào danh sách yêu thích!</p>
            <a href="/Story" class="btn-back">
                <i class="bi bi-arrow-left me-2"></i>Tìm truyện
            </a>
        </div>
    }
    else
    {
        <div class="stories-grid">
            @foreach (var story in Model)
            {
                <div class="story-card">
                    <div class="story-cover">
                        <img src="@story.CoverImage" alt="@story.Title" referrerpolicy="no-referrer" />
                    </div>
                    <div class="story-info">
                        <h3 class="story-title">@story.Title</h3>
                        <div class="story-author">@story.AuthorName</div>
                        
                        <div class="story-meta">
                            <i class="bi bi-star-fill"></i>
                            <span class="story-rating">@story.Rating.ToString("0.0")</span>
                            <span style="margin-left: auto;">@story.ChapterCount chương</span>
                        </div>

                        @if (story.StoryGenres.Any())
                        {
                            <div class="story-genres">
                                @foreach (var sg in story.StoryGenres.Take(2))
                                {
                                    <span class="genre-badge">@sg.Genre.Name</span>
                                }
                                @if (story.StoryGenres.Count > 2)
                                {
                                    <span class="genre-badge">+@(story.StoryGenres.Count - 2)</span>
                                }
                            </div>
                        }

                        <div class="story-actions">
                            @if (story.Chapters.Any())
                            {
                                <a href="/Story/Chapter/@story.Chapters.First().Id" class="btn-small btn-read">
                                    <i class="bi bi-book-open"></i> Đọc
                                </a>
                            }
                            <button type="button" class="btn-small btn-remove" onclick="removeFavorite(@story.Id)">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination">
                @if (ViewBag.Page > 1)
                {
                    <a href="/Story/Favorites?page=1">« Đầu tiên</a>
                    <a href="/Story/Favorites?page=@(ViewBag.Page - 1)">‹ Trước</a>
                }

                @for (int i = Math.Max(1, ViewBag.Page - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.Page + 2); i++)
                {
                    @if (i == ViewBag.Page)
                    {
                        <span class="active">@i</span>
                    }
                    else
                    {
                        <a href="/Story/Favorites?page=@i">@i</a>
                    }
                }

                @if (ViewBag.Page < ViewBag.TotalPages)
                {
                    <a href="/Story/Favorites?page=@(ViewBag.Page + 1)">Sau ›</a>
                    <a href="/Story/Favorites?page=@ViewBag.TotalPages">Cuối cùng »</a>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function removeFavorite(storyId) {
            if (confirm('Bạn chắc chắn muốn xóa truyện này khỏi danh sách yêu thích?')) {
                $.post('/Story/RemoveFavorite', { storyId: storyId }, function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                });
            }
        }
    </script>
}
