@{
    ViewData["Title"] = "Xác Thực Liên Kết - DocTruyen";
}

<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .otp-container {
        max-width: 500px;
        margin: 50px auto;
    }

    .otp-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border);
        padding: 40px 35px;
        text-align: center;
    }

    .otp-input {
        letter-spacing: 12px;
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        border: 2px solid var(--border);
        border-radius: 12px;
        padding: 10px;
        width: 220px;
        margin: 0 auto;
    }
    .otp-input:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(232, 160, 69, 0.15);
        outline: none;
    }

    .btn-otp-submit {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%);
        color: #1a1a2e;
        font-weight: 700;
        border: none;
        padding: 14px;
        border-radius: 12px;
        width: 100%;
        transition: all 0.2s;
        box-shadow: 0 6px 18px rgba(232, 160, 69, 0.25);
    }
    .btn-otp-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(232, 160, 69, 0.4);
        background: var(--gold-soft);
    }
</style>

<div class="container py-4">
    <div class="otp-container">
        
        <div class="otp-card">
            <div class="mb-4">
                <div class="avatar bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 75px; height: 75px;">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </div>
            </div>

            <h2 class="fw-bold mb-2" style="font-family: 'Playfair Display', serif; color: var(--ink);">Xác Thực OTP</h2>
            <p class="text-muted mb-4 small">Mã xác thực OTP đã được gửi đến số điện thoại đăng ký tài khoản ngân hàng của bạn. Vui lòng nhập mã để kích hoạt liên kết.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 small mb-4 text-start" style="border-radius: 10px; background-color: #f8d7da; color: #842029;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <div class="alert alert-info border-0 small mb-4 text-start" style="border-radius: 10px; background-color: #cff4fc; color: #055160;">
                <i class="bi bi-info-circle-fill me-2"></i> <strong>Kiểm thử:</strong> Sử dụng mã OTP mẫu là: <strong class="text-dark">123456</strong>
            </div>

            <form method="post" asp-action="ConfirmLinkBankOTP">
                <div class="mb-4">
                    <input type="text" class="otp-input" name="otpCode" maxlength="6" placeholder="000000" autocomplete="off" required pattern="[0-9]{6}" title="Mã OTP gồm 6 số" autofocus />
                </div>

                <div class="mb-4 text-muted small">
                    Hiệu lực của mã xác thực còn: <strong id="otpTimer" class="text-danger">02:00</strong>
                </div>

                <button type="submit" class="btn-otp-submit">
                    XÁC NHẬN LIÊN KẾT
                </button>
            </form>

            <div class="mt-4">
                <a href="/Account/LinkBank" class="text-decoration-none text-muted small">Quay lại nhập thông tin</a>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Countdown timer mô phỏng
        let timeLeft = 120; // 2 minutes
        const timerElement = document.getElementById("otpTimer");

        const interval = setInterval(function() {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(interval);
                timerElement.innerText = "Hết hạn";
                timerElement.classList.remove("text-danger");
                timerElement.classList.add("text-muted");
            } else {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                timerElement.innerText = 
                    (minutes < 10 ? "0" + minutes : minutes) + ":" + 
                    (seconds < 10 ? "0" + seconds : seconds);
            }
        }, 1000);
    });
</script>
