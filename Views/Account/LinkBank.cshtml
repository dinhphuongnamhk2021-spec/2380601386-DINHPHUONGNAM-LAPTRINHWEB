@{
    ViewData["Title"] = "Liên Kết Ngân Hàng - DocTruyen";
}

<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .link-container {
        max-width: 600px;
        margin: 50px auto;
    }

    .link-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border);
        padding: 35px;
    }

    .bank-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

    .bank-option {
        border: 2px solid var(--border);
        border-radius: 12px;
        padding: 16px 8px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 700;
        font-size: 0.9rem;
        background: #fff;
    }
    .bank-option:hover {
        border-color: var(--gold-soft);
        background: rgba(232, 160, 69, 0.02);
    }
    .bank-option.active {
        border-color: var(--gold);
        background: rgba(232, 160, 69, 0.06);
        color: var(--ink);
    }

    .form-control:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(232, 160, 69, 0.15);
    }

    .btn-link-submit {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%);
        color: #1a1a2e;
        font-weight: 700;
        border: none;
        padding: 14px;
        border-radius: 12px;
        width: 100%;
        transition: all 0.2s;
        box-shadow: 0 6px 18px rgba(232, 160, 69, 0.25);
    }
    .btn-link-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(232, 160, 69, 0.4);
        background: var(--gold-soft);
    }
</style>

<div class="container py-4">
    <div class="link-container">
        
        <div class="text-center mb-4">
            <a href="/Account/Profile" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Trở về trang cá nhân</a>
        </div>

        <div class="link-card">
            <h2 class="text-center fw-bold mb-2" style="font-family: 'Playfair Display', serif; color: var(--ink);">Liên Kết Ngân Hàng</h2>
            <p class="text-center text-muted mb-4 small">Liên kết tài khoản ngân hàng nội địa để nạp xu nhanh chóng với tính năng 1-Click Pay.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 small mb-4" style="border-radius: 10px; background-color: #f8d7da; color: #842029;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <form method="post" asp-action="LinkBank" id="bankLinkForm">
                <input type="hidden" name="bankName" id="selectedBankInput" value="Vietcombank" />

                <!-- Chọn Ngân hàng -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">1. Chọn ngân hàng liên kết</label>
                    <div class="bank-grid">
                        <div class="bank-option active" data-bank="Vietcombank">
                            <div class="fs-4 text-success mb-1"><i class="bi bi-bank"></i></div>
                            VCB
                        </div>
                        <div class="bank-option" data-bank="Techcombank">
                            <div class="fs-4 text-danger mb-1"><i class="bi bi-bank"></i></div>
                            TCB
                        </div>
                        <div class="bank-option" data-bank="BIDV">
                            <div class="fs-4 text-primary mb-1"><i class="bi bi-bank"></i></div>
                            BIDV
                        </div>
                        <div class="bank-option" data-bank="ACB">
                            <div class="fs-4 text-warning mb-1"><i class="bi bi-bank"></i></div>
                            ACB
                        </div>
                        <div class="bank-option" data-bank="MB Bank">
                            <div class="fs-4 text-info mb-1"><i class="bi bi-bank"></i></div>
                            MB
                        </div>
                        <div class="bank-option" data-bank="VietinBank">
                            <div class="fs-4 text-danger mb-1"><i class="bi bi-bank"></i></div>
                            CTG
                        </div>
                    </div>
                </div>

                <!-- Nhập Thông Tin -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">2. Nhập thông tin tài khoản</label>
                    
                    <div class="mb-3">
                        <label for="accountNumber" class="form-label small text-muted">Số tài khoản ngân hàng</label>
                        <input type="text" class="form-control form-control-lg" id="accountNumber" name="accountNumber" placeholder="Ví dụ: 1903456789012" required pattern="[0-9]{8,20}" title="Số tài khoản phải chứa từ 8 đến 20 số" />
                    </div>

                    <div class="mb-3">
                        <label for="accountName" class="form-label small text-muted">Tên chủ tài khoản (Không dấu)</label>
                        <input type="text" class="form-control form-control-lg text-uppercase" id="accountName" name="accountName" placeholder="Ví dụ: NGUYEN VAN A" required />
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label small text-muted">Số điện thoại đăng ký tại ngân hàng</label>
                        <input type="tel" class="form-control form-control-lg" id="phone" name="phone" placeholder="Ví dụ: 0987654321" required pattern="0[0-9]{9}" title="Số điện thoại gồm 10 số bắt đầu từ số 0" />
                    </div>
                </div>

                <button type="submit" class="btn-link-submit mt-2">
                    GỬI YÊU CẦU LIÊN KẾT
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const bankOptions = document.querySelectorAll(".bank-option");
        const selectedBankInput = document.getElementById("selectedBankInput");

        bankOptions.forEach(opt => {
            opt.addEventListener("click", function () {
                bankOptions.forEach(o => o.classList.remove("active"));
                this.classList.add("active");
                
                selectedBankInput.value = this.getAttribute("data-bank");
            });
        });
    });
</script>
