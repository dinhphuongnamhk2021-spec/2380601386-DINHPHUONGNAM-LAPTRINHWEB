@model DOANLAPTRINHWWEB.Models.User
@{
    ViewData["Title"] = "Hồ Sơ - DocTruyen";
}

@* ─── CSS riêng cho trang này ───────────────────────────────────────────── *@
<style>
    :root {
        --ink: #1a1a2e;
        --ink2: #16213e;
        --gold: #e8a045;
        --gold-soft: #f5c878;
        --muted: #6b7280;
        --card-bg: #ffffff;
        --border: #e5e7eb;
    }

    .profile-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 40px 0;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .profile-header::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse 80% 60% at 60% 50%, rgba(232,160,69,.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, var(--gold), var(--gold-soft));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        margin: 0 auto 20px;
        box-shadow: 0 8px 24px rgba(232,160,69,.4);
    }

    .profile-info h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
        text-align: center;
    }
    .profile-info .email {
        color: rgba(255,255,255,.7);
        text-align: center;
        font-size: 1rem;
        margin-bottom: 12px;
    }
    .profile-info .role {
        text-align: center;
    }
    .role-badge {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .role-admin {
        background: rgba(239, 68, 68, .2);
        color: #fca5a5;
    }
    .role-user {
        background: rgba(59, 130, 246, .2);
        color: #60a5fa;
    }

    .content-section {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--gold);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }
    .info-item {
        background: #f9fafb;
        padding: 16px;
        border-radius: 10px;
    }
    .info-label {
        color: var(--muted);
        font-size: 0.85rem;
        margin-bottom: 4px;
    }
    .info-value {
        color: var(--ink);
        font-weight: 600;
        font-size: 1rem;
    }

    .stories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }
    .story-card {
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        transition: transform .2s;
    }
    .story-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,.1);
    }
    .story-card-body {
        padding: 14px;
    }
    .story-title {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ink);
        margin-bottom: 8px;
        text-decoration: none;
        display: block;
    }
    .story-title:hover {
        color: var(--gold);
    }
    .story-meta {
        font-size: 0.8rem;
        color: var(--muted);
    }

    .btn-logout {
        background: rgba(239, 68, 68, .1);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, .3);
        padding: 10px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: all .2s;
    }
    .btn-logout:hover {
        background: rgba(239, 68, 68, .2);
        color: #dc2626;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--muted);
    }
</style>

@* Google Font Playfair Display *@
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

@* ─── PROFILE HEADER ─────────────────────────────────────────────────────────── *@
<div class="profile-header">
    <div class="container">
        <div class="profile-avatar">
            @Model.UserName.Substring(0, 1).ToUpper()
        </div>
        <div class="profile-info">
            <h1>@Model.UserName</h1>
            <div class="email">@Model.Email</div>
            <div class="role">
                @if (Model.Role == "Admin")
                {
                    <span class="role-badge role-admin">Admin</span>
                }
                else
                {
                    <span class="role-badge role-user">User</span>
                }
            </div>
        </div>
    </div>
</div>

@* ─── MAIN CONTENT ───────────────────────────────────────────────────────────── *@
<div class="container py-4">
    <div class="row">
        <div class="col-lg-8">
            @* User Information *@
            <div class="content-section">
                <h2 class="section-title">Thông Tin Cá Nhân</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Tên đăng nhập</div>
                        <div class="info-value">@Model.UserName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Vai trò</div>
                        <div class="info-value">@Model.Role</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Ngày tham gia</div>
                        <div class="info-value">@Model.CreatedAt.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>

            @* User's Stories *@
            <div class="content-section">
                <h2 class="section-title">Truyện Đã Đăng</h2>
                @if (Model.Stories.Any())
                {
                    <div class="stories-grid">
                        @foreach (var story in Model.Stories)
                        {
                            <div class="story-card">
                                <div class="story-card-body">
                                    <a asp-controller="Story" asp-action="Detail" asp-route-id="@story.Id" 
                                       class="story-title">@story.Title</a>
                                    <div class="story-meta">
                                        @story.Status · @story.ChapterCount chương
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <p>Bạn chưa đăng truyện nào.</p>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            @* Actions *@
            <div class="content-section">
                <h2 class="section-title">Hành Động</h2>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Story" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-house me-2"></i>Trang Chủ
                    </a>
                    @if (Model.Role == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-warning">
                            <i class="bi bi-gear me-2"></i>Quản Trị
                        </a>
                    }
                    <a asp-action="Logout" class="btn-logout text-center">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng Xuất
                    </a>
                </div>
            </div>

            @* Stats *@
            <div class="content-section">
                <h2 class="section-title">Thống Kê</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Truyện đã đăng</div>
                        <div class="info-value">@Model.Stories.Count</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Tổng lượt xem</div>
                        <div class="info-value">@Model.Stories.Sum(s => s.ViewCount).ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
